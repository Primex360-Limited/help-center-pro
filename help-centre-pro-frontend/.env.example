# Empty in local dev → Vite proxies /api to http://127.0.0.1:4008 (same-origin).
VITE_API_URL=
# Where the Vite dev server proxies /api + /health. Leave unset for the local
# backend; Docker Compose sets VITE_PROXY_TARGET=http://backend:4008.
# VITE_PROXY_TARGET=http://127.0.0.1:4008
# Production (Render) — must be the Node API service, not the static admin/web hosts:
# VITE_API_URL=https://helpcentre-pro-api.onrender.com
VITE_APP_NAME=HelpCentre Pro
# Optional — platform WebRTC gateway (Kamailio / FreeSWITCH / Asterisk
# `transport ws`). Carriers such as Stuncall publish only a SIP IP + UDP port,
# which no browser can dial. When this is set, every provider without its own
# WebSocket URL registers through this gateway and agents never paste a WSS URL.
# VITE_SIP_DEFAULT_WSS=wss://sip.your-domain.com:8089/ws

# Firebase Web config — Firebase Console → Project settings → Your apps → Web app
# Also enable Authentication → Sign-in method → Google
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=YOUR_PROJECT_ID.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=YOUR_PROJECT_ID
VITE_FIREBASE_STORAGE_BUCKET=YOUR_PROJECT_ID.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

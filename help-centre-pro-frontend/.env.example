# Empty in local dev → Vite proxies /api to http://127.0.0.1:4008 (same-origin).
VITE_API_URL=
# Production (Render):
# VITE_API_URL=https://helpcentre-pro-admin.onrender.com
VITE_APP_NAME=HelpCentre Pro

# Firebase Web config — Firebase Console → Project settings → Your apps → Web app
# Also enable Authentication → Sign-in method → Google
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=YOUR_PROJECT_ID.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=YOUR_PROJECT_ID
VITE_FIREBASE_STORAGE_BUCKET=YOUR_PROJECT_ID.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Leave empty in local dev so Vite proxies /api → :4008 (same-origin cookies).
# For a remote API, set e.g. VITE_API_URL=https://helpcentre-pro-admin.onrender.com
VITE_API_URL=
VITE_APP_NAME=HelpCentre Pro

# Firebase Web config (Console → Project settings → Your apps → Web)
# Enable Authentication → Sign-in method → Google, and add localhost to authorized domains
VITE_FIREBASE_API_KEY=YOUR_FIREBASE_API_KEY
VITE_FIREBASE_AUTH_DOMAIN=YOUR_PROJECT_ID.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=YOUR_PROJECT_ID
VITE_FIREBASE_STORAGE_BUCKET=YOUR_PROJECT_ID.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=YOUR_MESSAGING_SENDER_ID
VITE_FIREBASE_APP_ID=YOUR_FIREBASE_APP_ID

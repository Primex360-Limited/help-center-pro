generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL_PRODUCTION")
}

/////////////////////////////////////////////
// ENUMS (EXISTING + NEW)
//////////////////////////////////////////////////////

enum TicketStatus {
  QUEUED
  OPEN
  PENDING
  WAITING_FOR_REPLY
  RESOLVED
  CLOSED
}

enum MessageType {
  message
  internal_note
}

enum TicketPriority {
  LOW
  MEDIUM
  HIGH
}

enum TicketEventType {
  EMAIL
  CHAT
  CALL
  LOG
}

enum TicketChannel {
  EMAIL
  CHAT
  PHONE
}

enum SenderType {
  AGENT
  CUSTOMER
}

enum CallEventType {
  CALL_INITIATED
  CALL_RECEIVED
  CALL_PICKED
  CALL_HANGUP
}

enum CallActor {
  AGENT
  CUSTOMER
  SYSTEM
}

enum CallDirection {
  INBOUND
  OUTBOUND
}

//////////////////////////////////////////////////////
// MAIN TICKET MODEL (EXTENDED - NON BREAKING)
//////////////////////////////////////////////////////

model Ticket {
  id          String @id @default(uuid()) @db.Uuid
  ticketId    String @unique
  title       String
  description String

  // EXISTING
  status           TicketStatus @default(OPEN)
  assignedToUserId String?
  assignedToName   String?
  assignedToEmail  String?

  createdByUserId String
  createdByName   String
  createdByEmail  String

  updatedByUserId String?
  updatedByName   String?
  updatedByEmail  String?

  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  priority  TicketPriority @default(MEDIUM)

  // ✅ NEW CUSTOMER SNAPSHOT (ADDITIVE)
  customerId    String?
  customerName  String?
  customerEmail String?
  customerPhone String?
  customerIp    String?

  // Queue, SLA, and customer-waiting workflow fields.
  queuedAt               DateTime?
  pickedAt               DateTime?
  resolutionDueAt        DateTime?
  waitingForCustomerAt   DateTime?
  lastCustomerResponseAt DateTime?
  lastAgentResponseAt    DateTime?

  // EXISTING RELATIONS
  assignmentHistory TicketAssignmentHistory[]
  messages          TicketMessage[]
  statusHistory     TicketStatusHistory[]

  // ✅ NEW RELATION
  events TicketEvent[]

  @@index([status])
  @@index([priority])
  @@index([assignedToUserId])
  @@index([createdAt])
  @@index([customerId])
  @@index([customerIp])
  @@index([resolutionDueAt])
}

//////////////////////////////////////////////////////
// EXISTING MODELS (UNCHANGED)
//////////////////////////////////////////////////////

model TicketMessage {
  id           String      @id @default(uuid()) @db.Uuid
  ticketRefId  String      @db.Uuid
  senderUserId String
  senderName   String
  senderEmail  String
  messageType  MessageType @default(message)
  content      String
  createdAt    DateTime    @default(now())
  ticket       Ticket      @relation(fields: [ticketRefId], references: [id], onDelete: Cascade)

  @@index([ticketRefId, createdAt])
  @@index([messageType])
}

model TicketAssignmentHistory {
  id                       String   @id @default(uuid()) @db.Uuid
  ticketRefId              String   @db.Uuid
  previousAssignedToUserId String?
  previousAssignedToName   String?
  previousAssignedToEmail  String?
  newAssignedToUserId      String
  newAssignedToName        String
  newAssignedToEmail       String
  assignedByUserId         String
  assignedByName           String
  assignedByEmail          String
  transferReason           String?
  createdAt                DateTime @default(now())
  ticket                   Ticket   @relation(fields: [ticketRefId], references: [id], onDelete: Cascade)

  @@index([ticketRefId, createdAt])
}

model TicketStatusHistory {
  id              String        @id @default(uuid()) @db.Uuid
  ticketRefId     String        @db.Uuid
  oldStatus       TicketStatus?
  newStatus       TicketStatus
  changedByUserId String
  changedByName   String
  changedByEmail  String
  createdAt       DateTime      @default(now())
  ticket          Ticket        @relation(fields: [ticketRefId], references: [id], onDelete: Cascade)

  @@index([ticketRefId, createdAt])
}

//////////////////////////////////////////////////////
// NEW: THREAD CORE
//////////////////////////////////////////////////////

model TicketEvent {
  id        String          @id @default(uuid()) @db.Uuid
  ticketId  String          @db.Uuid
  type      TicketEventType
  channel   TicketChannel
  createdBy String // agent | customer | system
  createdAt DateTime        @default(now())
  metadata  Json?

  ticket Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  // Relations to channel data
  email TicketEmailMessage?
  chat  TicketChatMessage?
  call  TicketCall?

  @@index([ticketId, createdAt])
}

//////////////////////////////////////////////////////
// CHANNEL TABLES
//////////////////////////////////////////////////////

model TicketEmailMessage {
  id            String @id @default(uuid()) @db.Uuid
  ticketEventId String @unique @db.Uuid
  subject       String
  body          String
  fromEmail     String
  toEmail       String

  event TicketEvent @relation(fields: [ticketEventId], references: [id], onDelete: Cascade)
}

model TicketChatMessage {
  id            String     @id @default(uuid()) @db.Uuid
  ticketEventId String     @unique @db.Uuid
  message       String
  senderType    SenderType

  event TicketEvent @relation(fields: [ticketEventId], references: [id], onDelete: Cascade)
}

model TicketCall {
  id            String  @id @default(uuid()) @db.Uuid
  ticketEventId String  @unique @db.Uuid
  duration      Int?
  recordingUrl  String?

  event TicketEvent     @relation(fields: [ticketEventId], references: [id], onDelete: Cascade)
  logs  TicketCallLog[]
}

//////////////////////////////////////////////////////
// CALL LOGS (AUDIT TRAIL)
//////////////////////////////////////////////////////

model TicketCallLog {
  id        String         @id @default(uuid()) @db.Uuid
  callId    String         @db.Uuid
  eventType CallEventType
  actor     CallActor
  direction CallDirection?
  timestamp DateTime       @default(now())

  call TicketCall @relation(fields: [callId], references: [id], onDelete: Cascade)

  @@index([callId, timestamp])
}

//////////////////////////////////////////////////////
// PHASE 1 — MULTI-TENANCY & IDENTITY (POSTGRES)
//
// Enum values are intentionally lower-case so they match
// the existing string constants in shared/constants/system.js
// (same pattern the MessageType enum already uses).
//////////////////////////////////////////////////////

enum TenantStatus {
  provisioning
  active
  suspended
}

enum UserStatus {
  invited
  active
  inactive
  suspended
}

enum UserType {
  provider
  tenant
}

enum InvitationStatus {
  pending
  accepted
  expired
  revoked
}

model Tenant {
  id              String       @id @default(uuid()) @db.Uuid
  name            String
  slug            String       @unique
  primaryDomain   String?      @unique
  status          TenantStatus @default(provisioning)
  plan            String?
  seatLimit       Int?
  settings        Json?
  suspendedAt     DateTime?
  suspendedReason String?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  users         User[]
  roles         Role[]
  sessions      Session[]
  invitations   AgentInvitation[]
  auditLogs     AuditLog[]
  emailAccounts    EmailAccount[]
  messageTemplates MessageTemplate[]
  automationRules  AutomationRule[]

  @@index([status])
}

model Permission {
  id          String   @id @default(uuid()) @db.Uuid
  key         String   @unique
  description String?
  category    String?
  createdAt   DateTime @default(now())

  roles RolePermission[]

  @@index([category])
}

model Role {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String?  @db.Uuid
  name        String
  description String?
  isSystem    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant      Tenant?           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  permissions RolePermission[]
  users       User[]
  invitations AgentInvitation[]

  @@unique([tenantId, name])
  @@index([tenantId])
}

model RolePermission {
  roleId       String   @db.Uuid
  permissionId String   @db.Uuid
  createdAt    DateTime @default(now())

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
}

model User {
  id                 String     @id @default(uuid()) @db.Uuid
  tenantId           String?    @db.Uuid
  userType           UserType   @default(tenant)
  email              String
  passwordHash       String
  firstName          String
  lastName           String
  status             UserStatus @default(active)
  emailVerified      Boolean    @default(false)
  emailVerifiedAt    DateTime?
  mustChangePassword Boolean    @default(false)
  passwordChangedAt  DateTime?
  phoneNumber        String?
  profileImage       String?
  metadata           Json?
  deniedPermissions  String[]   @default([])
  roleId             String?    @db.Uuid
  invitedById        String?    @db.Uuid
  lastLoginAt        DateTime?
  isOnline           Boolean    @default(false)
  lastSeenAt         DateTime?
  // Profile setup fields
  timezone           String?
  industry           String?
  language           String?
  companySize        String?
  profileCompleted   Boolean    @default(false)
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt

  tenant              Tenant?              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  role                Role?                @relation(fields: [roleId], references: [id], onDelete: SetNull)
  invitedBy           User?                @relation("UserInvitedBy", fields: [invitedById], references: [id], onDelete: SetNull)
  invitedUsers        User[]               @relation("UserInvitedBy")
  sessions            Session[]
  invitationsSent     AgentInvitation[]    @relation("InvitationInvitedBy")
  invitationsReceived AgentInvitation[]    @relation("InvitationUser")
  passwordResetTokens PasswordResetToken[]
  verificationTokens  VerificationToken[]
  auditLogs           AuditLog[]
  emailAccounts       EmailAccount[]

  @@unique([tenantId, email])
  @@index([email])
  @@index([tenantId])
  @@index([roleId])
  @@index([status])
}

model Session {
  id               String   @id @default(uuid()) @db.Uuid
  userId           String   @db.Uuid
  tenantId         String?  @db.Uuid
  deviceInfo       String?
  ipAddress        String?
  refreshTokenHash String
  expiresAt        DateTime
  isRevoked        Boolean  @default(false)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenant Tenant? @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tenantId])
  @@index([refreshTokenHash])
  @@index([expiresAt])
}

model EmailAccount {
  id                String   @id @default(uuid()) @db.Uuid
  userId            String   @db.Uuid
  tenantId          String?  @db.Uuid
  provider          String   // gmail, outlook, custom
  email             String
  displayName       String?
  accessToken       String?  // encrypted
  refreshToken      String?  // encrypted
  tokenExpiresAt    DateTime?
  imapHost          String?
  imapPort          Int?
  imapSecure        Boolean  @default(true)
  smtpHost          String?
  smtpPort          Int?
  smtpSecure        Boolean  @default(true)
  isActive          Boolean  @default(true)
  isDefault         Boolean  @default(false)
  syncEnabled       Boolean  @default(true)
  lastSyncedAt      DateTime?
  lastSyncStatus    String?
  syncError         String?
  metadata          Json?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenant Tenant? @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([userId, email])
  @@index([userId])
  @@index([tenantId])
  @@index([provider])
  @@index([isActive])
  @@index([isDefault])
}

model MessageTemplate {
  id              String   @id @default(uuid()) @db.Uuid
  tenantId        String?  @db.Uuid
  name            String
  category        String   @default("General")
  content         String
  isActive        Boolean  @default(true)
  createdByUserId String?  @db.Uuid
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  tenant Tenant? @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([isActive])
}

/// Workspace automation rules (auto-acknowledge, routing, escalation…).
model AutomationRule {
  id              String   @id @default(uuid()) @db.Uuid
  tenantId        String?  @db.Uuid
  name            String
  type            String   @default("auto_acknowledge")
  description     String?
  assignToUserId  String?  @db.Uuid
  isActive        Boolean  @default(true)
  createdByUserId String?  @db.Uuid
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  tenant Tenant? @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([isActive])
}

model AgentInvitation {
  id          String           @id @default(uuid()) @db.Uuid
  tenantId    String           @db.Uuid
  userId      String?          @db.Uuid
  email       String
  firstName   String
  lastName    String
  roleId      String           @db.Uuid
  invitedById String           @db.Uuid
  tokenHash   String           @unique
  status      InvitationStatus @default(pending)
  expiresAt   DateTime
  acceptedAt  DateTime?
  revokedAt   DateTime?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  tenant    Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user      User?  @relation("InvitationUser", fields: [userId], references: [id], onDelete: SetNull)
  role      Role   @relation(fields: [roleId], references: [id], onDelete: Restrict)
  invitedBy User   @relation("InvitationInvitedBy", fields: [invitedById], references: [id], onDelete: Restrict)

  @@index([tenantId, status])
  @@index([email])
  @@index([expiresAt])
}

model PasswordResetToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  tokenHash String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tokenHash])
}

model VerificationToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  tokenHash String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tokenHash])
}

model AuditLog {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String?  @db.Uuid
  userId    String?  @db.Uuid
  action    String
  entity    String?
  entityId  String?
  metadata  Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant Tenant? @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([userId])
  @@index([action])
  @@index([createdAt])
}

/// Platform-wide content (provider Super Admin only). Keyed settings bag.
model PlatformSetting {
  key       String   @id
  value     Json
  updatedBy String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

PORT=4008
HOST=0.0.0.0
NODE_ENV=development
SERVICE_NAME=monolith
FRONTEND_URL=http://localhost:5173
ADMIN_FRONTEND_URL=http://localhost:5173

DATABASE_URL_PRODUCTION=postgresql://postgres:password@localhost:5433/help_center_pro?schema=public
POSTGRES_REQUIRED=true
MONGODB_REQUIRED=false

JWT_ACCESS_SECRET=help_center_pro_dev_access_secret_change_me_32chars
JWT_REFRESH_SECRET=help_center_pro_dev_refresh_secret_change_me_32chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

EMAIL_ENABLED=true
USE_NOTIFICATION_SERVICE=false
# Resend — platform transactional email ONLY (verification, invites, resets)
RESEND_API_KEY=
# Platform SMTP (support-mail fallback when no mailbox is connected). Leave SMTP_HOST
# empty in local dev — emails are logged to the console as [DEV INBOX].
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="HelpCentre Pro <noreply@helpcentrepro.com>"
SUPPORT_EMAIL_FROM="HelpCentre Pro Support <support@helpcentrepro.com>"
# Connected mailboxes (Settings -> Email): IMAP/SMTP two-way sync per agent.
# EMAIL_ENCRYPTION_KEY encrypts every stored mailbox token/app password.
# Set it ONCE to a long random string and never change it afterwards —
# changing it makes every already-connected mailbox unreadable.
EMAIL_ENCRYPTION_KEY=change-me-32-plus-characters-long
EMAIL_SYNC_INTERVAL=15000
EMAIL_SYNC_BATCH_SIZE=50
#
# --- Gmail "Sign in with Google" (optional; app-password connect always works) ---
# Google Cloud Console -> APIs & Services:
#   1. Enable the Gmail API.
#   2. OAuth consent screen: External, app name "HelpCentre Pro".
#      Add scope https://mail.google.com/ (required for IMAP/SMTP XOAUTH2).
#      While the app is in "Testing", add each agent as a Test user.
#   3. Credentials -> OAuth client ID (Web application) with
#      Authorized redirect URI exactly = GOOGLE_REDIRECT_URI below.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:5173/settings/email/callback/gmail
#
# --- Outlook "Sign in with Microsoft" (optional; app-password connect always works) ---
# Azure Portal -> App registrations -> New registration
# (Accounts in any organizational directory + personal Microsoft accounts):
#   1. Add a Web platform redirect URI exactly = MICROSOFT_REDIRECT_URI below.
#   2. API permissions -> Office 365 Exchange Online (delegated):
#      IMAP.AccessAsUser.All and SMTP.Send, plus Microsoft Graph: openid,
#      profile, email, offline_access. Grant admin consent if your tenant asks.
#   3. Certificates & secrets -> New client secret -> copy the VALUE (not the ID).
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_REDIRECT_URI=http://localhost:5173/settings/email/callback/outlook

REDIS_URL=redis://localhost:6379
REDIS_REQUIRED=false
# Keep false in shared/staging environments. Demo seed is opt-in only.
SEED_TEST_USER=false
SEED_DEMO_TICKETS=false
PURGE_DEMO_DATA=true

# Firebase Admin (Google sign-in) — Firebase Console → Project settings → Service accounts → Generate new private key
FIREBASE_PROJECT_ID=YOUR_PROJECT_ID
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@YOUR_PROJECT_ID.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY_HERE\n-----END PRIVATE KEY-----\n"

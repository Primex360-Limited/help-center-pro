PORT=4008
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

DATABASE_URL_PRODUCTION=postgresql://postgres:password@localhost:5433/help_center_pro?schema=public
POSTGRES_REQUIRED=true

JWT_ACCESS_SECRET=help_center_pro_dev_access_secret_change_me_32chars
JWT_REFRESH_SECRET=help_center_pro_dev_refresh_secret_change_me_32chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

EMAIL_ENABLED=true
RESEND_API_KEY=
EMAIL_FROM="HelpCentre Pro <noreply@helpcentrepro.com>"

REDIS_URL=redis://localhost:6379
REDIS_REQUIRED=false
SEED_TEST_USER=true

# Firebase Admin (Google sign-in) — Firebase Console → Project settings → Service accounts → Generate new private key
FIREBASE_PROJECT_ID=YOUR_PROJECT_ID
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@YOUR_PROJECT_ID.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY_HERE\n-----END PRIVATE KEY-----\n"
